<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="calculator.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:calculator"
    Shell.FlyoutBehavior="Disabled"
    Title="calculator">
    <TabBar>

        <Tab Title="Standart" Icon="icon_standard.png">
            <ShellContent
                ContentTemplate="{DataTemplate local:StandartPage}"
                Route="StandartPage" />
        </Tab>

        <Tab Title="Scientific" Icon="icon_scientific.png">
            <ShellContent
                ContentTemplate="{DataTemplate local:ScientificPage}"
                Route="ScientificPage" />
        </Tab>

    </TabBar>

</Shell>
