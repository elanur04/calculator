<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="calculator.ScientificPage"
             Title="Bilimsel">

    <ContentPage.Resources>
            <Style TargetType="Button">
                <Setter Property="Background" Value="Black"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="TextColor" Value="DeepPink"/>
                <Setter Property="FontSize" Value="25"/>
            </Style>
            <Style TargetType="Button" x:Key="Mb">
                <Setter Property="Background" Value="Black"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="TextColor" Value="DeepPink"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>
        </ContentPage.Resources>

        <Grid RowDefinitions="*,2*,*,*,*,*,*,*,*,*,*,*"
     
          ColumnDefinitions="*,*,*,*,*"  Margin="5">

            <Label x:Name="lblHistory" Text="" HorizontalTextAlignment="End"
               FontSize="Large" Margin="5"
               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"/>

        <Entry x:Name="cScreen" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" 
               FontSize="48" Text="0"
               HorizontalTextAlignment="End"
              
               />

        <Grid ColumnDefinitions="*,*,*,*,*,*,*,*" Grid.Row="0" Grid.Column="0">

            </Grid>


            <Grid ColumnDefinitions="*,*,*,*,*,*" Grid.Row="2" Grid.ColumnSpan="4">
                <Button Text="DEG" Grid.Column="0" Style="{StaticResource Mb}"/>
                <Button Text="F-E" Grid.Column="1" Style="{StaticResource Mb}"/>

            </Grid>

            <Grid ColumnDefinitions="*,*,*,*,*,*" Grid.Row="3" Grid.ColumnSpan="5">
                <Button Text="MC" Grid.Column="0" Style="{StaticResource Mb}" />
                <Button Text="MR" Grid.Column="1" Style="{StaticResource Mb}" />
                <Button Text="M+" Grid.Column="2" Style="{StaticResource Mb}" />
                <Button Text="M-" Grid.Column="3" Style="{StaticResource Mb}" />
                <Button Text="MS" Grid.Column="4" Style="{StaticResource Mb}" />
                <Button Text="Mv" Grid.Column="5" Style="{StaticResource Mb}" />

            </Grid>
            <Grid Grid.Row="4" Grid.ColumnSpan="5" ColumnDefinitions="*,*">
                <Button Text="Trigonometri v" 
                    Grid.Column="0" 
                    Style="{StaticResource Mb}"
                    Clicked="ToggleTrigonometryMenu_Clicked"/>

                <Button Text="f İşlev v" 
                    Grid.Column="1" 
                    Style="{StaticResource Mb}"/>
            </Grid>

            <Button Grid.Row="5" Grid.Column="0" Text="2^nd" />
            <Button Grid.Row="5" Grid.Column="1" Text="π" Clicked="Pi_Clicked" />
            <Grid x:Name="TrigonometryGrid"
              IsVisible="False"
              Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Grid.RowSpan="2"
              ZIndex="10"
              BackgroundColor="#E8E8E8"
              Padding="5"
              VerticalOptions="Start" >

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Text="X" Grid.Column="4" Clicked="ToggleTrigonometryMenu_Clicked" FontAttributes="Bold" BackgroundColor="Transparent"/>

                <Button x:Name="BtnSecond" Text="2nd" Grid.Row="0" Grid.Column="0" Clicked="SecondFunction_Clicked"/>
                <Button Text="sin" Grid.Row="0" Grid.Column="1" Clicked="TrigFunction_Clicked"/>
                <Button Text="cos" Grid.Row="0" Grid.Column="2" Clicked="TrigFunction_Clicked"/>
                <Button Text="tan" Grid.Row="0" Grid.Column="3" Clicked="TrigFunction_Clicked"/>

                <Button x:Name="BtnHyp" Text="hyp" Grid.Row="1" Grid.Column="0" />
                <Button Text="sec" Grid.Row="1" Grid.Column="1" Clicked="TrigFunction_Clicked"/>
                <Button Text="csc" Grid.Row="1" Grid.Column="2" Clicked="TrigFunction_Clicked"/>
                <Button Text="cot" Grid.Row="1" Grid.Column="3" Clicked="TrigFunction_Clicked"/>
            </Grid>

            <Button Grid.Row="5" Grid.Column="0" Text="2^nd" Clicked="SecondFunction_Clicked"/>
            <Button Grid.Row="5" Grid.Column="1" Text="π" Clicked="Pi_Clicked" />
            <Button Grid.Row="5" Grid.Column="2" Text="e" Clicked="E_Clicked"/>
            <Button Grid.Row="5" Grid.Column="3" Text="C" Clicked="Clear_Clicked"/>
            <Button Grid.Row="5" Grid.Column="4" Text="««" Clicked="BackSpaceClicked"/>

            <Button Grid.Row="6" Grid.Column="0" Text="x²" Clicked="Square_Clicked"/>
            <Button Grid.Row="6" Grid.Column="1" Text="1/x" Clicked="Reciprocal_Clicked"/>
            <Button Grid.Row="6" Grid.Column="2" Text="|x|" Clicked="Absolute_Clicked" />
            <Button Grid.Row="6" Grid.Column="3" Text="exp" Clicked="OperatorClicked"/>
            <Button Grid.Row="6" Grid.Column="4" Text="mod" Clicked="OperatorClicked"/>

            <Button Grid.Row="7" Grid.Column="0" Text="²√x" Clicked="SquareRoot_Clicked"/>
            <Button Grid.Row="7" Grid.Column="1" Text="("  />
            <Button Grid.Row="7" Grid.Column="2" Text=")"/>
            <Button Grid.Row="7" Grid.Column="3" Text="n!" Clicked="Factorial_Clicked"/>
            <Button Grid.Row="7" Grid.Column="4" Text="/" Clicked="OperatorClicked" />

            <Button Grid.Row="8" Grid.Column="0" Text="x^y" Clicked="OperatorClicked" />
            <Button Grid.Row="8" Grid.Column="1" Text="7" Clicked="NumClicked"/>
            <Button Grid.Row="8" Grid.Column="2" Text="8" Clicked="NumClicked"/>
            <Button Grid.Row="8" Grid.Column="3" Text="9" Clicked="NumClicked"/>
            <Button Grid.Row="8" Grid.Column="4" Text="*" Clicked="OperatorClicked"/>

            <Button Grid.Row="9" Grid.Column="0" Text="10^x" Clicked="TenPowerX_Clicked"/>
            <Button Grid.Row="9" Grid.Column="1" Text="4" Clicked="NumClicked" />
            <Button Grid.Row="9" Grid.Column="2" Text="5" Clicked="NumClicked" />
            <Button Grid.Row="9" Grid.Column="3" Text="6" Clicked="NumClicked" />
            <Button Grid.Row="9" Grid.Column="4" Text="-" Clicked="OperatorClicked"/>

            <Button Grid.Row="10" Grid.Column="0" Text="log" Clicked="Log_Clicked"/>
            <Button Grid.Row="10" Grid.Column="1" Text="1" Clicked="NumClicked" />
            <Button Grid.Row="10" Grid.Column="2" Text="2" Clicked="NumClicked" />
            <Button Grid.Row="10" Grid.Column="3" Text="3"  Clicked="NumClicked"/>
            <Button Grid.Row="10" Grid.Column="4" Text="+" Clicked="OperatorClicked" />

            <Button Grid.Row="11" Grid.Column="0" Text="ln" Clicked="Ln_Clicked" />
            <Button Grid.Row="11" Grid.Column="1" Text="+/-" Clicked="PlusMinus_Clicked"/>
            <Button Grid.Row="11" Grid.Column="2" Text="0" Clicked="NumClicked" />
            <Button Grid.Row="11" Grid.Column="3" Text="," Clicked="Decimal_Clicked"/>
            <Button Grid.Row="11" Grid.Column="4" Text="=" Clicked="EqualClicked"/>

        </Grid>

    </ContentPage>


